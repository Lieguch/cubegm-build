+/* Debug: crash backtrace to /mnt/sdcard/crash.log (build with -rdynamic for
+ * symbol names; addresses always available). Helps diagnose the SIG=11s seen
+ * on device (e.g. FrogUI load crash in payload-263).
+ * v8.6: covers SIGBUS/SIGILL/SIGFPE too, and appends the ROM/core context so
+ * a crash.log says WHICH rom was loading (the 005-fceumm case had no usable
+ * clue before). */
+static char g_crash_ctx[384] = "";
+static void pa_crash_handler(int sig) {
+    void *bt[24];
+    int n = backtrace(bt, 24);
+    const char *nm = sig == SIGSEGV ? "SIGSEGV" : sig == SIGABRT ? "SIGABRT"
+                   : sig == SIGBUS  ? "SIGBUS"  : sig == SIGILL  ? "SIGILL"
+                   : sig == SIGFPE  ? "SIGFPE"  : "SIG";
+    int fd = open("/mnt/sdcard/crash.log", O_WRONLY|O_CREAT|O_APPEND, 0644);
+    if (fd >= 0) {
+        dprintf(fd, "=== %s pid=%d pc=%p %s ===\n", nm, (int)getpid(), bt[0], g_crash_ctx);
+        backtrace_symbols_fd(bt, n, fd);
+        dprintf(fd, "---\n");
+        close(fd);
+    }
+    /* also one line on stderr (lands in zhijack.log) — async-signal-safe */
+    {
+        char ln[96];
+        int m = snprintf(ln, sizeof ln, "CRASH %s pc=%p ctx=%s\n", nm, bt[0], g_crash_ctx);
+        if (m > 0) write(2, ln, m < (int)sizeof ln ? m : (int)sizeof ln);
+    }
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
+/* install the crash.log handler for the full crash signal set. Exported so
+ * main() can install it at startup (before any core/dlopen — the earlier
+ * default handler only wrote one line to stderr and no crash.log). */
+void pa_crash_install(void) {
+    struct sigaction sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_handler = pa_crash_handler;
+    sigemptyset(&sa.sa_mask);
+    sigaction(SIGSEGV, &sa, NULL);
+    sigaction(SIGABRT, &sa, NULL);
+    sigaction(SIGBUS,  &sa, NULL);
+    sigaction(SIGILL,  &sa, NULL);
+    sigaction(SIGFPE,  &sa, NULL);
+}
+
 void core_load(void) {
+    pa_crash_install();
 	current_core.retro_init();
 	current_core.initialized = true;
 	PA_INFO("Finished loading core\n");
@@ -784,6 +853,12 @@ int core_load_content(struct content *content) {
 	int ret = -1;
