+                         g_fbw, g_fbh, g_fbbpp, g_fbstride);
+            fprintf(stderr, "hwdisp: RK3036G fb0-direct active %dx%d bpp=%d\n",
+                    g_fbw, g_fbh, g_fbbpp);
