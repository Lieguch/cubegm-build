+        }
+        hwdisp_fslog("hwdisp_init: RK3036G fb0 open FAILED (fbmem=%p fbw=%d fbh=%d) errno=%d",
+                     (void*)g_fbmem, g_fbw, g_fbh, errno);
+        fprintf(stderr, "hwdisp: RK3036G fb0 open failed\n");
+        return -1;
+    }
+
     sf3000_dump_fb_state("hwdisp_init/pre");
 
     /* Device-specific driver: each device ships its own driver.so build (panel
@@ -546,7 +1030,10 @@ int hwdisp_present_direct(const void *src, int w, int h, int pitch_bytes) {
     static int s_n = 0;
     int lg = (s_n < 8);
