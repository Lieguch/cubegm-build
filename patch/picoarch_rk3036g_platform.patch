diff --git a/plat_rk3036g.c b/plat_rk3036g.c
new file mode 100644
index 0000000..b5325e1
--- /dev/null
+++ b/plat_rk3036g.c
@@ -0,0 +1,91 @@
+/*
+ * plat_rk3036g.c -- RK3036G (ARM Cortex-A7, HDMI-only) platform layer.
+ *
+ * This is the direction-A port (charter §0.4): a clean, self-contained
+ * platform backend for the RK3036G CubeGM handheld, replacing the SF2000
+ * transitional patches (plat_sf3000.c / cubevol shm / /dev/dis / driver.so).
+ *
+ * Hardware facts (from payload-305/307 device diag_report.txt):
+ *   - SoC: RK3036 dual Cortex-A7 @ ~1.0 GHz, ARMv7-A NEON, 244 MB RAM
+ *   - Display: DRM/KMS only (card0-HDMI-A-1), 1280x720p60. /dev/fb0 is a
+ *     legacy emulation that does NOT drive the HDMI scanout (payload-305
+ *     black screen root cause). Rendering goes through hwdisp.c DRM dumb
+ *     buffer + SETCRTC (verified 48 FPS on payload-307).
+ *   - Audio: ALSA "rockchip,hdmi" card, i2s-hifi PCM (default).
+ *   - Input: standard evdev. Two "Twin USB Gamepad" (VID:0810 PID:0001)
+ *     report BTN_* buttons (codes 288-297) + ABS_X/ABS_Y dpad, plus a
+ *     "key" gpio-keys device (EV_KEY only, KEY=80000).
+ *
+ * Structure mirrors plat_linux.c: define the evdev default-bind tables, then
+ * pull in the shared plat_sdl.c implementation (which provides plat_init,
+ * the SDL framebuffer surface, and calls in_evdev_init for gamepad input).
+ */
+#include <SDL/SDL.h>
+#include <linux/input.h>
+#include "libretro.h"
+#include "libpicofe/plat.h"
+#include "libpicofe/input.h"
+#include "libpicofe/in_sdl.h"
+#include "main.h"
+#include "util.h"
+
+/* Gamepad button bindings -> libretro joypad IDs.
+ *
+ * The "Twin USB Gamepad" reports buttons as BTN_TRIGGER..BTN_BASE4
+ * (Linux input codes 288..297) plus ABS_X/ABS_Y for the dpad. The exact
+ * physical-button <-> BTN_code mapping must be confirmed with the device's
+ * one-key-at-a-time diag capture (direction B). These are the standard
+ * Linux gamepad defaults; A2 calibrates them against the diag keymap.
+ */
+static const struct in_default_bind in_evdev_defbinds[] = {
+	/* dpad (ABS axes are handled by in_evdev's abs->digital mapping;
+	 * BTN_DPAD_* entries are a fallback for hats that report as keys) */
+	{ BTN_DPAD_UP,    IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_UP    },
+	{ BTN_DPAD_DOWN,  IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_DOWN  },
+	{ BTN_DPAD_LEFT,  IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_LEFT  },
+	{ BTN_DPAD_RIGHT, IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_RIGHT },
+
+	/* face buttons (standard mapping; A2 calibrates to real BTN codes) */
+	{ BTN_A,          IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_A      },
+	{ BTN_B,          IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_B      },
+	{ BTN_X,          IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_X      },
+	{ BTN_Y,          IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_Y      },
+
+	/* shoulders */
+	{ BTN_TL,         IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_L      },
+	{ BTN_TR,         IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_R      },
+	{ BTN_TL2,        IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_L2     },
+	{ BTN_TR2,        IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_R2     },
+
+	{ BTN_SELECT,     IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_SELECT },
+	{ BTN_START,      IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_START  },
+	{ BTN_MODE,       IN_BINDTYPE_EMU,      EACTION_MENU                  },
+	{ 0, 0, 0 }
+};
+
+/* Menu navigation (evdev keycodes -> unified PBTN_*). */
+const struct menu_keymap in_evdev_key_map[] = {
+	{ BTN_DPAD_UP,    PBTN_UP    },
+	{ BTN_DPAD_DOWN,  PBTN_DOWN  },
+	{ BTN_DPAD_LEFT,  PBTN_LEFT  },
+	{ BTN_DPAD_RIGHT, PBTN_RIGHT },
+	{ BTN_A,          PBTN_MOK   },
+	{ BTN_B,          PBTN_MBACK },
+	{ BTN_START,      PBTN_MENU  },
+	/* keyboard-arrow fallback (dpad hats mapped to these by in_evdev) */
+	{ KEY_UP,         PBTN_UP    },
+	{ KEY_DOWN,       PBTN_DOWN  },
+	{ KEY_LEFT,       PBTN_LEFT  },
+	{ KEY_RIGHT,      PBTN_RIGHT },
+};
+
+static const struct in_pdata in_evdev_platform_data = {
+	.defbinds  = in_evdev_defbinds,
+	.key_map   = in_evdev_key_map,
+	.kmap_size = array_size(in_evdev_key_map),
+	.joy_map   = NULL,
+	.jmap_size = 0,
+	.key_names = NULL,
+};
+
+#include "plat_sdl.c"
