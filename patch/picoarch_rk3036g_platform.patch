     in_probe();
@@ -1610,8 +1610,8 @@ dbg_log("DBG M3: sound init done\n");
 		PA_ERROR("SDL input failed to init: %s\n", SDL_GetError());
 		return -1;
 	}
-#ifdef PLATFORM_SF3000
-	/* Generic evdev gamepad backend (see plat_sf3000.c). */
+#if defined(PLATFORM_SF3000) || defined(PLATFORM_RK3036G)
+	/* Generic evdev gamepad backend (see plat_sf3000.c / plat_rk3036g.c). */
 	in_evdev_init(&in_evdev_platform_data);
 #endif
 	in_probe();
