diff --git a/libpicofe/linux/in_evdev.c b/libpicofe/linux/in_evdev.c
index ff714ce..fd6d05d 100644
--- a/libpicofe/linux/in_evdev.c
+++ b/libpicofe/linux/in_evdev.c
@@ -365,6 +365,20 @@ static int in_evdev_update(void *drv_data, const int *binds, int *result)
 		}
 	}
 
+	/* d-pad hat (ABS_HAT0X/HAT0Y) -> digital UDLR. Many pads report the
+	 * d-pad as a hat rather than BTN_DPAD_* (e.g. Twin USB Gamepad whose
+	 * stock profile lists hat=1). EVIOCGABS returns -1 if unsupported. */
+	ret = ioctl(dev->fd, EVIOCGABS(ABS_HAT0X), &ainfo);
+	if (ret != -1) {
+		if (ainfo.value < 0) or_binds(binds, KEY_LEFT, result);
+		if (ainfo.value > 0) or_binds(binds, KEY_RIGHT, result);
+	}
+	ret = ioctl(dev->fd, EVIOCGABS(ABS_HAT0Y), &ainfo);
+	if (ret != -1) {
+		if (ainfo.value < 0) or_binds(binds, KEY_UP, result);
+		if (ainfo.value > 0) or_binds(binds, KEY_DOWN, result);
+	}
+
 	return 0;
 }
 
