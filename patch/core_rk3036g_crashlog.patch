 	return 0;
 }
 
+/* Debug: crash backtrace to /mnt/sdcard/crash.log (build with -rdynamic for
+ * symbol names; addresses always available). Helps diagnose the SIG=11s seen
+ * on device (e.g. FrogUI load crash in payload-263). */
+static void pa_crash_handler(int sig) {
+    void *bt[24];
+    int n = backtrace(bt, 24);
+    int fd = open("/mnt/sdcard/crash.log", O_WRONLY|O_CREAT|O_APPEND, 0644);
+    if (fd >= 0) {
+        dprintf(fd, "=== %s pid=%d pc=%p ===\n",
+                sig == SIGSEGV ? "SIGSEGV" : (sig == SIGABRT ? "SIGABRT" : "SIG"),
+                (int)getpid(), bt[0]);
+        backtrace_symbols_fd(bt, n, fd);
+        dprintf(fd, "---\n");
+        close(fd);
+    }
+    signal(sig, SIG_DFL);
+    raise(sig);
+}
+
 void core_load(void) {
+    struct sigaction sa;
+    memset(&sa, 0, sizeof sa);
+    sa.sa_handler = pa_crash_handler;
+    sigaction(SIGSEGV, &sa, NULL);
+    sigaction(SIGABRT, &sa, NULL);
 	current_core.retro_init();
 	current_core.initialized = true;
 	PA_INFO("Finished loading core\n");
@@ -810,6 +836,11 @@ int core_load_content(struct content *content) {
 	DBG("DBG M5b: retro_load_game path=%s\n", game_info.path ? game_info.path : "(null)");
 	if (!current_core.retro_load_game(&game_info)) {
 		PA_ERROR("Couldn't load content\n");
+		/* Mark not-initialized so core_unload() skips retro_unload_game() /
+		 * retro_deinit(): some cores (fceumm on bad ROM) crash in unload ->
+		 * observed SIG=11 right after "Unloading core...". dlclose alone is
+		 * safe. */
+		current_core.initialized = false;
 		goto finish;
 	}
 	DBG("DBG M5c: retro_load_game returned\n");
