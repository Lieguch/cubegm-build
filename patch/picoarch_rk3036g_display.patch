+/* RK3036G has no SF3000-class panel/DT nodes — detect via the SoC compatible
+ * string the kernel exposes. Returns 1 if /proc/device-tree/compatible lists
+ * an rk3036 SoC (e.g. "rockchip,rk3036"). rk3032-dongle does NOT match. */
+static int tf_device_is_rk3036(void) {
+    FILE *f = fopen("/proc/device-tree/compatible", "r");
+    if (!f) return 0;
+    char buf[256]; int n = fread(buf, 1, sizeof buf - 1, f); fclose(f);
+    if (n <= 0) return 0;
+    buf[n] = 0;
+    return strstr(buf, "rk3036") != NULL;
+}
