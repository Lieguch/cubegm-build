+static void plat_sound_finish_alsa(void) {
+    if (g_alsa_pcm && p_snd_pcm_close) p_snd_pcm_close(g_alsa_pcm);
+    g_alsa_pcm = NULL; g_alsa_ok = 0;
+    if (g_alsa_handle) { dlclose(g_alsa_handle); g_alsa_handle = NULL; }
