+ * SF3000 init log in plat_sdl.c. */
+static void hwdisp_fslog(const char *fmt, ...) {
+    int fd = open("/mnt/sdcard/picoarch_init.log", O_WRONLY|O_CREAT|O_APPEND, 0644);
