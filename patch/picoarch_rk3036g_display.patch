+    p_snd_pcm_set_params = (alsa_setparams_fn)dlsym(g_alsa_handle, "snd_pcm_set_params");
+    p_snd_pcm_writei     = (alsa_writei_fn)dlsym(g_alsa_handle, "snd_pcm_writei");
+    p_snd_pcm_close      = (alsa_close_fn)dlsym(g_alsa_handle, "snd_pcm_close");
