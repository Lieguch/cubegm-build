+    int n = vsnprintf(buf, sizeof buf, fmt, ap); va_end(ap);
+    if (n > 0) (void)!write(fd, buf, (size_t)n);
+    (void)!dprintf(fd, "\n");
+    fsync(fd); close(fd);
