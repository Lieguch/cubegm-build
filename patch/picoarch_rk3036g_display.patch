+/* RK3036G has no SF3000-class panel/DT nodes — detect via the SoC compatible
+ * string the kernel exposes. Returns 1 if /proc/device-tree/compatible lists
+ * an rk3036 OR rk3032 SoC. DEVICE EVIDENCE (K:/picoarch_init.log payload-236):
+ * this RK3036G unit's stock kernel DT compatible is 'rockchip,rk3032-dongle'
+ * (uname says rk3036; stock firmware reuses the rk3032 board DT), so BOTH
+ * strings must classify as RK3036G. */
+/* fsync'd file log (black-screen evidence; stderr is invisible on device). */
+static void sf3000_fslog(const char *fmt, ...) {
+    int il = open("/mnt/sdcard/picoarch_init.log", O_WRONLY|O_CREAT|O_APPEND, 0644);
+    if (il < 0) return;
+    char buf[512]; va_list ap; va_start(ap, fmt);
+    int n = vsnprintf(buf, sizeof buf, fmt, ap); va_end(ap);
+    if (n > 0) (void)!write(il, buf, (size_t)n);
+    (void)!dprintf(il, "\n");
+    fsync(il); close(il);
+}
+
+static int tf_device_is_rk3036(void) {
+    FILE *f = fopen("/proc/device-tree/compatible", "r");
+    if (!f) { sf3000_fslog("tf_device_is_rk3036: fopen /proc/device-tree/compatible FAILED errno=%d", errno); return 0; }
+    char buf[256]; int n = fread(buf, 1, sizeof buf - 1, f); fclose(f);
+    if (n <= 0) { sf3000_fslog("tf_device_is_rk3036: fread EMPTY (n=%d)", n); return 0; }
+    buf[n] = 0;
+    /* rk3036 OR rk3032 (device evidence: DT says 'rockchip,rk3032-dongle'). */
+    int match = (strstr(buf, "rk3036") != NULL) || (strstr(buf, "rk3032") != NULL);
+    sf3000_fslog("tf_device_is_rk3036: n=%d match=%d content='%s'", n, match, buf);
+    return match;
+}
