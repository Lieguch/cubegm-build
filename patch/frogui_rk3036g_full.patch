+/* RK3036G/CubeGM: fall back on file extension when a ROM sits in a folder
+ * that is not in console_mappings (e.g. .bin/.md dumped straight into the
+ * /roms root -> folder == "roms" matches nothing, so nothing happened). */
+static const char* get_core_for_file(const char *path) {
+    const char *ext = strrchr(path, '.');
+    if (!ext) return NULL;
+    if (strcasecmp(ext, ".bin") == 0 || strcasecmp(ext, ".md") == 0 ||
+        strcasecmp(ext, ".smd") == 0 || strcasecmp(ext, ".gen") == 0)
+        return CORES_PATH "/picodrive_libretro.so";
+    if (strcasecmp(ext, ".cue") == 0 || strcasecmp(ext, ".iso") == 0 ||
+        strcasecmp(ext, ".chd") == 0)
+        return CORES_PATH "/pcsx_rearmed_libretro.so";
+    if (strcasecmp(ext, ".zip") == 0)
+        return CORES_PATH "/fbalpha2012_libretro.so";
+    if (strcasecmp(ext, ".nes") == 0 || strcasecmp(ext, ".fds") == 0)
+        return CORES_PATH "/fceumm_libretro.so";
+    if (strcasecmp(ext, ".sfc") == 0 || strcasecmp(ext, ".smc") == 0)
+        return CORES_PATH "/snes9x2005_plus_libretro.so";
+    if (strcasecmp(ext, ".gba") == 0) return CORES_PATH "/mgba_libretro.so";
+    if (strcasecmp(ext, ".gb") == 0 || strcasecmp(ext, ".gbc") == 0)
+        return CORES_PATH "/tgbdual_libretro.so";
+    if (strcasecmp(ext, ".a26") == 0) return CORES_PATH "/stella2014_libretro.so";
+    return NULL;
