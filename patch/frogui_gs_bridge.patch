-// For SF2000, use the custom dirent implementation
-#include "../../dirent.h"
-#else
+/* CubeGM / RK3036G launch bridge (replaces the SF2000-only gs interface).
+   Upstream only declared the gs game-launch symbols under #ifdef SF2000
+   (a hardcoded ROM loader at 0x80001500). On this standard-Linux device we
+   KEEP the gs symbol NAMES (so the four launch sites are unchanged) but back
+   them with a real buffer and a functional direct_loader() stub that bridges
+   to picoarch's native launch protocol instead of the SF2000 ROM loader. */
 #include <dirent.h>
-#endif
+
+#define CUBEGM_CORES_DIR "/mnt/sda1/cubegm/cores"
+#define CUBEGM_LAUNCH_FILE "/tmp/frogui_launch.txt"
+
+static char gs_run_game_file[512];
+static char gs_run_game_name[128];
+static char gs_run_rom_fullpath[512];
+char *ptr_gs_run_game_file = gs_run_game_file;
+char *ptr_gs_run_game_name = gs_run_game_name;
+
+static int gs_request_shutdown = 0;
+
+/* Upstream called the SF2000 ROM loader here. We instead write picoarch's
+   native launch file (core .so path + ROM path) and flag a shutdown so
+   picoarch execl()s into the chosen core+rom (its fork/waitpid model). */
+static void direct_loader(const char *stub_path, int unused) {
+    (void)stub_path; (void)unused;
+    char core_buf[256];
+    const char *semi = strchr(ptr_gs_run_game_file, ';');
+    size_t n = semi ? (size_t)(semi - ptr_gs_run_game_file) : strlen(ptr_gs_run_game_file);
+    if (n >= sizeof(core_buf)) n = sizeof(core_buf) - 1;
+    memcpy(core_buf, ptr_gs_run_game_file, n);
+    core_buf[n] = '\0';
+    char core_so[512];
+    snprintf(core_so, sizeof(core_so), "%s/%s_libretro.so", CUBEGM_CORES_DIR, core_buf);
+    FILE *lf = fopen(CUBEGM_LAUNCH_FILE, "w");
+    if (lf) {
+        fprintf(lf, "%s\n%s\n", core_so, gs_run_rom_fullpath);
+        fclose(lf);
+    }
+    gs_request_shutdown = 1;
+}
 
