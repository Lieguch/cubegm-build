+/* ---- CubeGM open-source native launch protocol ---------------------------
+ * The closed-source stock firmware exposed ptr_gs_run_game_* / /*REMOVED*/
+ * (only declared under SF2000). This port ships picoarch, whose main loop
+ * (quit() in picoarch main.c) reads /tmp/frogui_launch.txt at exit (a core
+ * .so path + a ROM path) and exec's into that core+rom. We write that file
+ * and request RETRO_ENVIRONMENT_SHUTDOWN instead of calling stock firmware.
+ * CUBEGM_CORES_DIR is the on-device directory holding the libretro cores; it
+ * is a deployment constant (tune to match the SD layout at bring-up). */
+#ifndef LAUNCH_FILE
+#define LAUNCH_FILE "/tmp/frogui_launch.txt"
 #endif
+#ifndef CUBEGM_CORES_DIR
+#define CUBEGM_CORES_DIR "/mnt/sda1/cubegm/cores"
+#endif
+static char g_launch_core[512];
+static char g_launch_rom[1024];
+
+static void request_native_launch(const char *core_name, const char *rom_full_path) {
+    snprintf(g_launch_core, sizeof(g_launch_core), "%s/%s_libretro.so",
+             CUBEGM_CORES_DIR, core_name ? core_name : "");
+    snprintf(g_launch_rom, sizeof(g_launch_rom), "%s",
+             rom_full_path ? rom_full_path : "");
+    FILE *lf = fopen(LAUNCH_FILE, "w");
+    if (lf) {
+        fprintf(lf, "%s
+%s
+", g_launch_core, g_launch_rom);
+        fclose(lf);
+    }
+}
 
