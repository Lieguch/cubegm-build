+/* ----------------------------------------------------------------------------
+ * Generic evdev gamepad backend (RK3036G / SF3000)
+ *
+ * The Linux kernel's usbhid layer maps EVERY standard HID gamepad to the same
+ * BTN_*/ABS_* event codes, so a generic evdev reader supports ALL such pads
+ * with zero per-device profiles. This backend is activated alongside SDL
+ * (see plat_sdl.c init, guarded by PLATFORM_SF3000): SDL keeps driving the
+ * built-in panel, evdev automatically picks up any plugged-in USB gamepad.
+ *
+ * The SF3000 panel is read via its own hardware register (sf3000_keys_ptr),
+ * NOT evdev, so there is no double-reporting.
+ *
+ * BTN_* codes are stable Linux ABI constants; defined locally (guarded) so we
+ * don't pull <linux/input.h> into the SDL-including TU.
+ * -------------------------------------------------------------------------- */
+#ifndef BTN_A
+#define BTN_A      0x130
+#define BTN_B      0x131
+#define BTN_C      0x132
+#define BTN_X      0x133
+#define BTN_Y      0x134
+#define BTN_Z      0x135
+#define BTN_TL     0x136
+#define BTN_TR     0x137
+#define BTN_TL2    0x138
+#define BTN_TR2    0x139
+#define BTN_SELECT 0x13a
+#define BTN_START  0x13b
+#define BTN_MODE   0x13c
+#define BTN_THUMBL 0x13d
+#define BTN_THUMBR 0x13e
+#define BTN_DPAD_UP    0x220
+#define BTN_DPAD_DOWN  0x221
+#define BTN_DPAD_LEFT  0x222
+#define BTN_DPAD_RIGHT 0x223
+#endif
+
+/* evdev keycode -> libretro joypad button. D-pad buttons AND the left analog
+ * stick (ABS_X/ABS_Y, digital-mapped by in_evdev) both reach U/D/L/R. */
+static const struct in_default_bind in_evdev_defbinds[] = {
+    { BTN_DPAD_UP,    IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_UP },
+    { BTN_DPAD_DOWN,  IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_DOWN },
+    { BTN_DPAD_LEFT,  IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_LEFT },
+    { BTN_DPAD_RIGHT, IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_RIGHT },
+    { BTN_A,          IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_B },
+    { BTN_B,          IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_A },
+    { BTN_X,          IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_Y },
+    { BTN_Y,          IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_X },
+    { BTN_TL,         IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_L },
+    { BTN_TR,         IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_R },
+    { BTN_TL2,        IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_L2 },
+    { BTN_TR2,        IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_R2 },
+    { BTN_THUMBL,     IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_L3 },
+    { BTN_THUMBR,     IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_R3 },
+    { BTN_SELECT,     IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_SELECT },
+    { BTN_START,      IN_BINDTYPE_PLAYER12, RETRO_DEVICE_ID_JOYPAD_START },
+    /* Guide button opens the pause menu (matches handheld SELECT+START) */
+    { BTN_MODE,       IN_BINDTYPE_EMU, EACTION_MENU },
+    { 0, 0, 0 }
+};
+
+/* evdev keycode -> unified PBTN (menu navigation) */
+const struct menu_keymap in_evdev_key_map[] = {
+    { BTN_DPAD_UP,    PBTN_UP },
+    { BTN_DPAD_DOWN,  PBTN_DOWN },
+    { BTN_DPAD_LEFT,  PBTN_LEFT },
+    { BTN_DPAD_RIGHT, PBTN_RIGHT },
+    { BTN_A,          PBTN_MOK },
+    { BTN_B,          PBTN_MBACK },
+    { BTN_MODE,       PBTN_MENU },
+};
+
+static const struct in_pdata in_evdev_platform_data = {
+    .defbinds  = in_evdev_defbinds,
+    .key_map   = in_evdev_key_map,
+    .kmap_size = array_size(in_evdev_key_map),
+    .joy_map   = NULL,
+    .jmap_size = 0,
+    .key_names = NULL,
+};
+
