@@ -30,7 +30,23 @@
 
 #define SDCARD_BASE  "/mnt/sdcard"
 #define CORES_PATH   SDCARD_BASE "/cubegm/cores"
-#define ROMS_PATH    SDCARD_BASE "/roms"
+/* ROM root resolved at runtime: the stock card ships "Roms" (uppercase) while
+ * the FrogUI convention is "roms". FAT mounts are usually case-insensitive,
+ * but ext4/case-sensitive mounts would leave the menu black/empty. Probe both.
+ * (Observed on the RK3036G unit: SD root shows stock files like "11.png" and
+ * the menu came up black because only /mnt/sdcard/roms was probed.) */
+#define ROMS_PATH_DEFAULT SDCARD_BASE "/roms"
+static char g_roms_path[512];
+static const char* roms_path(void) {
+    if (g_roms_path[0]) return g_roms_path;
+    /* Real-device finding: FrogUI's /roms resolved to the stock Roms/ (FAT
+     * case-insensitive) and dumped its mixed contents (003/004/PS1 + loose
+     * .bin files + SAVE + root.dat) straight into the menu. The stock card
+     * root actually carries the 000-008 category folders, so show the SD root
+     * and let the user pick a category; Roms/ remains reachable as a folder. */
+    strcpy(g_roms_path, SDCARD_BASE);
+    return g_roms_path;
+}
 #define LAUNCH_FILE  "/tmp/frogui_launch.txt"
 
