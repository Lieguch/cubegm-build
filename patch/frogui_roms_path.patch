 }
 
-void retro_reset(void) { scan_directory(ROMS_PATH); strncpy(current_path, ROMS_PATH, MAX_PATH_LEN-1); }
+void retro_reset(void) { strncpy(current_path, roms_path(), MAX_PATH_LEN-1); current_path[MAX_PATH_LEN-1]=0; scan_directory(current_path); }
 
