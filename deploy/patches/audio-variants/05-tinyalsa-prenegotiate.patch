From: CubeGM v4.0 <hermes@local>
Subject: [PATCH] 05-tinyalsa-prenegotiate.patch

v4.0: tinyalsa pre-negotiate acodec-ana VWL via libasound.
tinyalsa 直连 /dev/snd/pcmC0D0p 绕过 ALSA 协商层 -> acodec-ana (hw:0,1)
的 R02.VWL 停留复位默认 24bit，S16 数据被 24bit 错读 -> 量化台阶感 +
混叠金属感（diag v3.0/v4.0 实证）。用 dlopen libasound 完整协商链打开
hw:0,1 一次触发 inno_rk3036 codec 把 VWL 设 16bit，再 tinyalsa 直连。
dlopen 方式零编译期 ALSA 依赖，失败静默降级（回到现状）。

diff --git a/audio/drivers/tinyalsa.c b/audio/drivers/tinyalsa.c
index 9ecfeba..903e572 100644
--- a/audio/drivers/tinyalsa.c
+++ b/audio/drivers/tinyalsa.c
@@ -51,6 +51,7 @@
 #include <errno.h>
 #include <unistd.h>
 #include <poll.h>
+#include <dlfcn.h>
 
 #include <sys/ioctl.h>
 #include <sys/mman.h>
@@ -2235,6 +2236,72 @@ static void * tinyalsa_init(const char *devicestr, unsigned rate,
    config.stop_threshold    = 0;
    config.silence_threshold = 0;
 
+   /* ---- CubeGM v4.0: pre-negotiate acodec-ana VWL via libasound ----
+    * tinyalsa 直连 /dev/snd/pcmC0D0p 绕过 ALSA 协商层，acodec-ana
+    * (hw:0,1, 内置扬声器 DAC) 的 R02.VWL 停留在复位默认 24bit，而
+    * 应用数据是 S16_LE -> 24bit 误读 16bit -> 量化台阶感 + 混叠金属感
+    * (diag v3.0/v4.0 实证)。此段用 libasound 完整协商链打开 hw:0,1
+    * 一次（open -> hw_params S16/48k/stereo -> close），触发内核 DAI
+    * link 激活，让 inno_rk3036 codec 驱动把 VWL 设成 16bit，然后
+    * tinyalsa 再直连 hw:0,0 播放（I2S 共享总线广播到扬声器）。
+    * dlopen 方式：零编译期 ALSA 依赖，失败静默降级（回到现状），
+    * 绝不比现状差。 */
+   {
+      void *asound = dlopen("libasound.so.2", RTLD_LAZY | RTLD_LOCAL);
+      if (asound)
+      {
+         typedef int (*p_open_fn)(void **, const char *, int, int);
+         typedef int (*p_hmalloc_fn)(void **);
+         typedef int (*p_any_fn)(void *, void *);
+         typedef int (*p_setacc_fn)(void *, void *, int);
+         typedef int (*p_setfmt_fn)(void *, void *, int);
+         typedef int (*p_setch_fn)(void *, void *, unsigned);
+         typedef int (*p_setrate_fn)(void *, void *, unsigned *, int);
+         typedef int (*p_hwparams_fn)(void *, void *);
+         typedef int (*p_hwfree_fn)(void *);
+         typedef int (*p_close_fn)(void *);
+         p_open_fn     p_open    = (p_open_fn)    dlsym(asound, "snd_pcm_open");
+         p_hmalloc_fn  p_hmalloc = (p_hmalloc_fn) dlsym(asound, "snd_pcm_hw_params_malloc");
+         p_any_fn      p_any     = (p_any_fn)     dlsym(asound, "snd_pcm_hw_params_any");
+         p_setacc_fn   p_setacc  = (p_setacc_fn)  dlsym(asound, "snd_pcm_hw_params_set_access");
+         p_setfmt_fn   p_setfmt  = (p_setfmt_fn)  dlsym(asound, "snd_pcm_hw_params_set_format");
+         p_setch_fn    p_setch   = (p_setch_fn)   dlsym(asound, "snd_pcm_hw_params_set_channels");
+         p_setrate_fn  p_setrate = (p_setrate_fn) dlsym(asound, "snd_pcm_hw_params_set_rate_near");
+         p_hwparams_fn p_hw      = (p_hwparams_fn) dlsym(asound, "snd_pcm_hw_params");
+         p_hwfree_fn   p_hwfree  = (p_hwfree_fn)  dlsym(asound, "snd_pcm_hw_params_free");
+         p_close_fn    p_close   = (p_close_fn)   dlsym(asound, "snd_pcm_close");
+         if (p_open && p_hmalloc && p_any && p_setacc && p_setfmt &&
+             p_setch && p_setrate && p_hw && p_hwfree && p_close)
+         {
+            void *pcm = NULL;
+            if (p_open(&pcm, "hw:0,1", 0 /*SND_PCM_STREAM_PLAYBACK=0*/, 0) == 0 && pcm)
+            {
+               void *params = NULL;
+               if (p_hmalloc(&params) == 0 && params)
+               {
+                  unsigned int nrate = rate;
+                  if (p_any(pcm, params) == 0 &&
+                      p_setacc(pcm, params, 3 /*RW_INTERLEAVED*/) == 0 &&
+                      p_setfmt(pcm, params, 2 /*SND_PCM_FORMAT_S16_LE*/) == 0 &&
+                      p_setch(pcm, params, 2) == 0 &&
+                      p_setrate(pcm, params, &nrate, 0) == 0 &&
+                      p_hw(pcm, params) == 0)
+                  {
+                     RARCH_LOG("[TINYALSA] pre-negotiate ALSA ok: acodec VWL=16\n");
+                  }
+                  else
+                     RARCH_WARN("[TINYALSA] pre-negotiate ALSA hw_params failed\n");
+                  p_hwfree(params);
+               }
+               p_close(pcm);
+            }
+            else
+               RARCH_WARN("[TINYALSA] pre-negotiate ALSA open hw:0,1 failed\n");
+         }
+         dlclose(asound);
+      }
+   }
+
    tinyalsa->pcm = pcm_open(card, device, PCM_OUT, &config);
 
    if (!tinyalsa->pcm)
