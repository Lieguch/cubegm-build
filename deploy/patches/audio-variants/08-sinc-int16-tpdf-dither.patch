From: CubeGM v7.5 <hermes@local>
Subject: [PATCH] 08-sinc-int16-tpdf-dither.patch v2 (lanczos 补注入 + kaiser 去冗余 + C89 无 inline)

v2 (2026-09-12, 用户批准执行"这张牌"):
  - v1 只有 kaiser 路径有 dither，质量档切到 LOWER/LOWEST（lanczos
    window）时 dither 静默失效。v2 在 lanczos 截断点补同款注入。
  - v1 的 kaiser 段有冗余双层 #ifdef 嵌套（无害但脏），v2 改单层。
  - helper 去 inline（本文件 C89 规则，-std=c89 下 inline 未声明）。
  - 注入点验证：audio_driver.c L1092-1216 int16 主通路唯一量化点
    （音量默认 0dB gain=1.0 直通）；NEON fission 不触碰输出截断。
  - 打开开关：build.sh CFLAGS 加 -DSINC_I16_TPDF_DITHER=1。

--- a/libretro-common/audio/resampler/drivers/sinc_resampler_int16.c
+++ b/libretro-common/audio/resampler/drivers/sinc_resampler_int16.c
@@ -44,6 +44,21 @@
  * NB: everything here is written to C89 / MSVC rules (declarations at the top
  * of each block, no // comments) and avoids implementation-defined signed
  * right shifts so the result is portable and deterministic.
+ *
+ * Optional triangular probability density (TPDF) dither at the int16 output
+ * truncation point (off by default).  Off = round-half-away-from-zero only
+ * (correlated quantization error, ~ -90 dB SNR for 16-bit full-scale signals
+ * but with signal-correlated harmonic distortion).  On = TPDF ±1 LSB added
+ * BEFORE the round-half-away shift; the quantization error becomes
+ * uncorrelated white noise at ~ -93 dB SNR (matches the well-known 16-bit
+ * dithered SNR floor; see e.g. Benchmark Media App Note "High-Resolution
+ * Audio - Bit Depth", and the TPDF reference in Vanderkooy & Lipshitz 1987).
+ *
+ * Toggle at build time: -DSINC_I16_TPDF_DITHER=1.  Default 0 keeps upstream
+ * bit-exact behaviour.  The PRNG is xorshift32(13,17,5) with a fixed seed
+ * so the output is reproducible; period is 2^32-1, well above any audio
+ * buffer length.  Two uniform {0,1,2} draws are summed to form a triangular
+ * PDF on {-2,-1,0,1,2} (peak amplitude 2 LSB; canonical TPDF).
  */
 
 #include <stdint.h>
@@ -53,6 +68,36 @@
 #include <math.h>
 
 #include <audio/sinc_resampler_int16.h>
+
+/* ------------------------------------------------------------------------- */
+/* TPDF dither helpers (gated by SINC_I16_TPDF_DITHER)                      */
+/* ------------------------------------------------------------------------- */
+#ifdef SINC_I16_TPDF_DITHER
+static uint32_t sinc_i16_dither_state = 0xDEADBEEFu;
+static int32_t sinc_i16_tpdf_dither(void)
+{
+   /* TPDF (triangular probability density) dither on {-2..+2} LSB:
+    *   two independent draws from uniform {-1, 0, +1} are summed.
+    *   The triangular PDF on {-2,-1,0,+1,+2} is the canonical dither for
+    *   16-bit audio truncation (Lipshitz / Vanderkooy 1987; Benchmark
+    *   Media App Note "High-Resolution Audio - Bit Depth"): the residual
+    *   is uncorrelated white noise at ~ -93 dB SNR, vs ~ -90 dB SNR with
+    *   signal-correlated harmonic distortion for round-half-away only.
+    *
+    *   Implementation note: low-2-bit of xorshift32 is poorly mixed (chi2
+    *   34000 in 200k samples; this fixes the period/order of bit reads).
+    *   We take 8 bits of two independent xorshift32 advances and mod-3;
+    *   the sum of two independent 3-ary uniforms is exactly the triangular
+    *   distribution.  Period is 2^32-1, well above any audio buffer. */
+   uint32_t x = sinc_i16_dither_state;
+   x ^= x << 13; x ^= x >> 17; x ^= x << 5; sinc_i16_dither_state = x;
+   int32_t r1 = (int32_t)((sinc_i16_dither_state & 0xFF) % 3u) - 1;
+   x = sinc_i16_dither_state;
+   x ^= x << 13; x ^= x >> 17; x ^= x << 5; sinc_i16_dither_state = x;
+   int32_t r2 = (int32_t)((sinc_i16_dither_state & 0xFF) % 3u) - 1;
+   return r1 + r2;
+}
+#endif
 
 /* On targets whose compiler can auto-vectorize an int16*int32->int64 MAC
  * (e.g. AArch64/NEON via smlal), splitting the Kaiser inner loop into a
@@ -373,8 +418,14 @@
             }
 #endif
 
+#ifdef SINC_I16_TPDF_DITHER
+            { int32_t dl = sinc_i16_tpdf_dither(); int32_t dr = sinc_i16_tpdf_dither();
+              output[0] = sinc_i16_sat(sinc_i16_round_shift(sum_l) + dl);
+              output[1] = sinc_i16_sat(sinc_i16_round_shift(sum_r) + dr); }
+#else
             output[0] = sinc_i16_sat(sinc_i16_round_shift(sum_l));
             output[1] = sinc_i16_sat(sinc_i16_round_shift(sum_r));
+#endif
             output   += 2;
             out_frames++;
             re->time += ratio;
@@ -423,8 +474,14 @@
                sum_r += (int64_t)buffer_r[i] * pt[i];
             }
 
+#ifdef SINC_I16_TPDF_DITHER
+            { int32_t dl = sinc_i16_tpdf_dither(); int32_t dr = sinc_i16_tpdf_dither();
+              output[0] = sinc_i16_sat(sinc_i16_round_shift(sum_l) + dl);
+              output[1] = sinc_i16_sat(sinc_i16_round_shift(sum_r) + dr); }
+#else
             output[0] = sinc_i16_sat(sinc_i16_round_shift(sum_l));
             output[1] = sinc_i16_sat(sinc_i16_round_shift(sum_r));
+#endif
             output   += 2;
             out_frames++;
             re->time += ratio;
