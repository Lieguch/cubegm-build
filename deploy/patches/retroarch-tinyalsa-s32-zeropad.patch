diff --git a/audio/drivers/tinyalsa.c b/audio/drivers/tinyalsa.c
index 9ecfeba..f757575 100644
--- a/audio/drivers/tinyalsa.c
+++ b/audio/drivers/tinyalsa.c
@@ -2226,8 +2226,7 @@ static void * tinyalsa_init(const char *devicestr, unsigned rate,
       *new_rate = rate;
 
    config.rate              = rate;
-   config.format            = is_little_endian() ?\
-                              PCM_FORMAT_S16_LE : PCM_FORMAT_S16_BE;
+   config.format            = PCM_FORMAT_S32_LE;
    config.channels          = 2;
    config.period_size       = 1024;
    config.period_count      = 4;
@@ -2299,6 +2298,49 @@ tinyalsa_write(void *data, const void *buf_, size_t len)
    snd_pcm_sframes_t size    = BYTES_TO_FRAMES(len, tinyalsa->frame_bits);
    size_t frames_size        = tinyalsa->has_float ? sizeof(float) : sizeof(int16_t);
 
+   /* v0.8 (2026-08-31): S32_LE 整数格式的 S16 -> S32 转换（根治 407 无声） */
+   if ((tinyalsa->frame_bits > 32) && !tinyalsa->has_float)
+   {
+      snd_pcm_sframes_t in_frames = (snd_pcm_sframes_t)(len / 4);
+      size_t in_samples           = (size_t)in_frames * 2;
+      const int16_t *in           = (const int16_t*)buf_;
+      int32_t *out                = NULL;
+      snd_pcm_sframes_t i;
+
+      (void)size;
+      (void)frames_size;
+
+      if (in_frames <= 0)
+         return 0;
+
+      out = (int32_t*)malloc(in_samples * sizeof(int32_t));
+      if (!out)
+         return -1;
+
+      for (i = 0; i < (snd_pcm_sframes_t)in_samples; i++)
+         out[i] = (int32_t)in[i];
+
+      while (in_frames)
+      {
+         snd_pcm_sframes_t written  = pcm_writei(tinyalsa->pcm, out, in_frames);
+
+         if (written < 0)
+         {
+            pcm_stop(tinyalsa->pcm);
+            free(out);
+            return -1;
+         }
+
+         _len += written;
+         if (in_frames > written)
+            memmove(out, out + written * 2,
+                  (size_t)(in_frames - written) * 2 * sizeof(int32_t));
+         in_frames -= written;
+      }
+      free(out);
+      return _len;
+   }
+
    if (tinyalsa->nonblock)
    {
       while (size)
