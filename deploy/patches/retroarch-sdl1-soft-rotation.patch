    if (!frame)
+   /* handle rotation */
+
+   unsigned rot = vid->rotation;
+
+   const void *src_frame = frame;
+
+   unsigned src_w = width, src_h = height, src_pitch = pitch;
+
+   enum scaler_pix_fmt fmt = vid->scaler.in_fmt;
+
+   int bpp = (fmt == SCALER_FMT_ARGB8888) ? 4 : 2;
+
+   if (rot == 1 || rot == 3) {
+
+      unsigned new_w = src_h, new_h = src_w;
+
+      size_t need = new_w * new_h * bpp;
+
+      if (vid->rotate_buf_size < need) {
+
+         vid->rotate_buf = realloc(vid->rotate_buf, need);
+
+         vid->rotate_buf_size = need;
+
+      }
+
+      if (vid->rotate_buf) {
+
+         const uint8_t *s = (const uint8_t*)src_frame;
+
+         uint8_t *d = (uint8_t*)vid->rotate_buf;
+
+         for (unsigned y = 0; y < src_h; y++) {
+
+            for (unsigned x = 0; x < src_w; x++) {
+
+               size_t so = y * src_pitch + x * bpp;
+
+               unsigned dx, dy;
+
+               if (rot == 1) { dx = src_h - 1 - y; dy = x; }
+
+               else { dx = y; dy = src_w - 1 - x; }
+
+               size_t dof = dy * new_w * bpp + dx * bpp;
+
+               if (bpp == 4) *(uint32_t*)(d + dof) = *(const uint32_t*)(s + so);
+
+               else *(uint16_t*)(d + dof) = *(const uint16_t*)(s + so);
+
+            }
+
+         }
+
+         src_frame = vid->rotate_buf;
+
+         src_w = new_w; src_h = new_h;
+
+         src_pitch = new_w * bpp;
+
+      }
+
+   } else if (rot == 2) {
+
+      size_t need = src_w * src_h * bpp;
+
+      if (vid->rotate_buf_size < need) {
+
+         vid->rotate_buf = realloc(vid->rotate_buf, need);
+
+         vid->rotate_buf_size = need;
+
+      }
+
+      if (vid->rotate_buf) {
+
+         const uint8_t *s = (const uint8_t*)src_frame;
+
+         uint8_t *d = (uint8_t*)vid->rotate_buf;
+
+         for (unsigned y = 0; y < src_h; y++) {
+
+            for (unsigned x = 0; x < src_w; x++) {
+
+               size_t so = y * src_pitch + x * bpp;
+
+               size_t dof = (src_h - 1 - y) * src_w * bpp + (src_w - 1 - x) * bpp;
+
+               if (bpp == 4) *(uint32_t*)(d + dof) = *(const uint32_t*)(s + so);
+
+               else *(uint16_t*)(d + dof) = *(const uint16_t*)(s + so);
+
+            }
+
+         }
+
+         src_frame = vid->rotate_buf;
+
+         src_pitch = src_w * bpp;
+
+      }
+
+   }
