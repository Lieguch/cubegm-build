+static void sdl_gfx_set_rotation(void *data, unsigned rotation)
+{
+   sdl_video_t *vid = (sdl_video_t*)data;
+   if (vid)
+      vid->rotation = rotation % 4;
+}
+
 static bool sdl_gfx_frame(void *data, const void *frame, unsigned width,
       unsigned height, uint64_t frame_count,
       unsigned pitch, const char *msg, video_frame_info_t *video_info)
 {
    char title[128];
+   unsigned rot = 0;
+   const void *src_frame = NULL;
+   unsigned src_w = 0;
+   unsigned src_h = 0;
+   unsigned src_pitch = 0;
+   unsigned old_w = 0;
+   unsigned out_w = 0;
+   enum scaler_pix_fmt fmt;
+   int bpp;
+   unsigned dst_pitch = 0;
+   const uint8_t *src = NULL;
+   uint8_t *dst = NULL;
+   unsigned y = 0;
+   unsigned x = 0;
+   size_t so = 0;
+   size_t dof = 0;
+   unsigned dx = 0;
+   unsigned dy = 0;
+   size_t need = 0;
    sdl_video_t   *vid = (sdl_video_t*)data;
 #ifdef HAVE_MENU
    bool menu_is_alive = (video_info->menu_st_flags & MENU_ST_FLAG_ALIVE) ? true : false;
 #endif
 
+   rot = vid->rotation;
+   src_frame = frame;
+   src_w = width;
+   src_h = height;
+   src_pitch = pitch;
+   old_w = width;
+   fmt = vid->scaler.in_fmt;
+   bpp = (fmt == SCALER_FMT_ARGB8888) ? 4 : 2;
+
+   /* Software rotation: SDL1 driver has no SET_ROTATION support
+    * (upstream issue #7447). Transpose the core frame in a plain
+    * CPU buffer before scaling, mirroring stock driver behavior. */
+   if (rot == 1 || rot == 3)
+   {
+      out_w = src_h;
+      need = (size_t)out_w * old_w * bpp;
+      if (vid->rotate_buf_size < need)
+      {
+         void *nb = realloc(vid->rotate_buf, need);
+         if (nb)
+         {
+            vid->rotate_buf = nb;
+            vid->rotate_buf_size = need;
+         }
+      }
+      if (vid->rotate_buf && vid->rotate_buf_size >= need)
+      {
+         src = (const uint8_t*)src_frame;
+         dst = (uint8_t*)vid->rotate_buf;
+         dst_pitch = out_w * bpp;
+         for (y = 0; y < src_h; y++)
+         {
+            for (x = 0; x < src_w; x++)
+            {
+               so = (size_t)y * src_pitch + (size_t)x * bpp;
+               if (rot == 1)
+               {
+                  dx = src_h - 1 - y;
+                  dy = x;
+               }
+               else
+               {
+                  dx = y;
+                  dy = src_w - 1 - x;
+               }
+               dof = (size_t)dy * dst_pitch + (size_t)dx * bpp;
+               if (bpp == 4)
+                  *(uint32_t*)(dst + dof) = *(const uint32_t*)(src + so);
+               else
+                  *(uint16_t*)(dst + dof) = *(const uint16_t*)(src + so);
+            }
+         }
+         src_frame = dst;
+         src_w = out_w;
+         src_h = old_w;
+         src_pitch = dst_pitch;
+      }
+   }
+   else if (rot == 2)
+   {
+      need = (size_t)src_w * src_h * bpp;
+      if (vid->rotate_buf_size < need)
+      {
+         void *nb = realloc(vid->rotate_buf, need);
+         if (nb)
+         {
+            vid->rotate_buf = nb;
+            vid->rotate_buf_size = need;
+         }
+      }
+      if (vid->rotate_buf && vid->rotate_buf_size >= need)
+      {
+         src = (const uint8_t*)src_frame;
+         dst = (uint8_t*)vid->rotate_buf;
+         dst_pitch = src_w * bpp;
+         for (y = 0; y < src_h; y++)
+         {
+            for (x = 0; x < src_w; x++)
+            {
+               so = (size_t)y * src_pitch + (size_t)x * bpp;
+               dof = (size_t)(src_h - 1 - y) * dst_pitch + (size_t)(src_w - 1 - x) * bpp;
+               if (bpp == 4)
+                  *(uint32_t*)(dst + dof) = *(const uint32_t*)(src + so);
+               else
+                  *(uint16_t*)(dst + dof) = *(const uint16_t*)(src + so);
+            }
+         }
+         src_frame = dst;
+         src_pitch = dst_pitch;
+      }
+   }
+
    if (!frame)
       return true;
 
@@ -381,13 +512,13 @@ static bool sdl_gfx_frame(void *data, const void *frame, unsigned width,
    video_frame_scale(
          &vid->scaler,
