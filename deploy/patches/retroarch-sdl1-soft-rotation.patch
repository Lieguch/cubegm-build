+
+   if (rot == 1 || rot == 3)               /* 90° or 270° */
+   {
+      unsigned new_w = src_h, new_h = src_w;
+      size_t need = new_w * new_h * bpp;
+      if (vid->rotate_buf_size < need)
+      {
+         if (vid->rotate_buf)
+            SDL_FreeSurface(vid->rotate_buf);
+         vid->rotate_buf = SDL_CreateRGBSurfaceWithFormat(0,
+               new_w, new_h, bpp * 8,
+               (fmt == SCALER_FMT_ARGB8888) ? SDL_PIXELFORMAT_ARGB8888
+                                            : SDL_PIXELFORMAT_RGB565);
+         vid->rotate_buf_size = need;
+      }
+      if (vid->rotate_buf)
+      {
+         const uint8_t *src = (const uint8_t *)src_frame;
+         uint8_t *dst = (uint8_t *)vid->rotate_buf->pixels;
+         unsigned dst_pitch = vid->rotate_buf->pitch;
+
+         for (unsigned y = 0; y < src_h; ++y)
+         {
+            for (unsigned x = 0; x < src_w; ++x)
+            {
+               size_t src_off = y * src_pitch + x * bpp;
+               unsigned dx, dy;
+               if (rot == 1) { dx = src_h - 1 - y; dy = x; }          /* 90° cw */
+               else        { dx = y; dy = src_w - 1 - x; }          /* 270° cw */
+               size_t dst_off = dy * dst_pitch + dx * bpp;
+               if (bpp == 4)
+                  *(uint32_t *)(dst + dst_off) = *(const uint32_t *)(src + src_off);
+               else
+                  *(uint16_t *)(dst + dst_off) = *(const uint16_t *)(src + src_off);
+            }
+         }
+
+         src_frame   = vid->rotate_buf->pixels;
+         src_w       = new_w;
+         src_h       = new_h;
+         src_pitch   = vid->rotate_buf->pitch;
+      }
+   }
+   else if (rot == 2)                    /* 180° */
+   {
+      size_t need = src_w * src_h * bpp;
+      if (vid->rotate_buf_size < need)
+      {
+         if (vid->rotate_buf)
+            SDL_FreeSurface(vid->rotate_buf);
+         vid->rotate_buf = SDL_CreateRGBSurfaceWithFormat(0,
+               src_w, src_h, bpp * 8,
+               (fmt == SCALER_FMT_ARGB8888) ? SDL_PIXELFORMAT_ARGB8888
+                                            : SDL_PIXELFORMAT_RGB565);
+         vid->rotate_buf_size = need;
