# CubeGM ~/.asoundrc — 音频根治 v11.6（官方 @hooks 自动加载，不打补丁）
# 设备 rootfs 自带 /usr/share/alsa/alsa.conf；其 @hooks 会加载 /etc/asound.conf 与 ~/.asoundrc。
# HOME=/mnt/sdcard/cubegm -> 本文件 = /mnt/sdcard/cubegm/.asoundrc，开机自动生效。
# 目标：pcm.!default = plug -> route -> multi(hw:0,0 HDMI + hw:0,1 内置扬声器) 双输出，
#       恢复原厂"双通道同时出声"行为。
# 铁律：slave 必须【内联 type hw】（禁止字符串 "hw:0,0"——官方 pcm.default 用 plug 包裹 hw，
#       但 multi 的 slave 若用字符串会因配置树评估顺序不可靠而失败；本机 ALSA 模拟已验证）。
#       禁改 44100/48000（plug 自动采样率转换）。hint 块 device_output 是整数域，勿写字符串。
pcm.dual {
    type multi
    slaves.a.pcm { type hw  card 0  device 0 }   # HDMI
    slaves.b.pcm { type hw  card 0  device 1 }   # 内置扬声器 (rk3036-voice)
    slaves.a.channels 2
    slaves.b.channels 2
    bindings.0.slave a
    bindings.0.channel 0
    bindings.1.slave a
    bindings.1.channel 1
    bindings.2.slave b
    bindings.2.channel 0
    bindings.3.slave b
    bindings.3.channel 1
}
pcm.dualroute {
    type route
    slave.pcm "dual"
    slave.channels 4
    ttable.0.0 1.0
    ttable.1.1 1.0
    ttable.0.2 1.0
    ttable.1.3 1.0
}
pcm.!default {
    type plug
    slave.pcm "dualroute"
}
ctl.!default {
    type hw
    card 0
}
