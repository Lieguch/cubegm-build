<?xml version="1.0" encoding="utf-8" ?>
<!--
  CubeGM open-source replacement core registry (deploy/cubegm/cores/config.xml)
  ----------------------------------------------------------------------------
  This is the registry for the OPEN-SOURCE replacement front-end (picoarch +
  FrogUI). Unlike the stock firmware, which uses the device's custom-ABI
  libemu_*.so cores, the open-source path loads STANDARD libretro cores
  (built from upstream by deploy/build.sh). The <emucore file="..."/> names
  below are the canonical libretro .so filenames that build.sh produces.

  Systems covered = the 20 the stock firmware supports, PLUS the two that were
  present-but-unregistered on the device (GBA via gpsp, Atari 7800 via
  prosystem), PLUS a few extras so we EXCEED stock (PC Engine, Neo Geo,
  ScummVM, PrBoom/Doom, SameBoy).

  To use on the STOCK firmware WITHOUT building anything: copy ONLY this file
  over your device's existing cores/config.xml — it enables gpsp (GBA) and
  prosystem (Atari 7800) immediately (those .so already ship on the device).
-->
<core>
<emucore name="Arcade (FBA)" file="fbalpha_libretro.so" />
<supported_extensions>ZIP</supported_extensions>
<supported_extensions>7Z</supported_extensions>
</core>

