<?xml version="1.0" encoding="utf-8" ?>
<!--
  CubeGM open-source replacement core registry (deploy/cubegm/cores/config.xml)
  ----------------------------------------------------------------------------
  Registry for the OPEN-SOURCE front-end (picoarch + FrogUI). The build
  (deploy/build.sh) compiles exactly these 5 standard libretro cores; this file
  is trimmed to MATCH what is actually shipped in cubegm/cores/ so the launcher
  never presents a core whose .so is absent.

  <emucore file="..."/> values are the canonical libretro .so filenames that
  build.sh produces (see STAGE 7 per-core recipes).

  To ADD more systems (gpsp/GBA-lite, prosystem/Atari7800, PC Engine, Neo Geo,
  ScummVM, etc.) build the corresponding libretro core in STAGE 7 and register
  it here. Tracked as Stage-2 work (see HANDOFF.md).
-->
<core>
<emucore name="SNES" file="snes9x_libretro.so" />
<supported_extensions>SMC</supported_extensions>
<supported_extensions>SFC</supported_extensions>
<supported_extensions>SWC</supported_extensions>
<supported_extensions>FIG</supported_extensions>
</core>

<core>
<emucore name="GBA (mGBA)" file="mgba_libretro.so" />
<supported_extensions>GBA</supported_extensions>
<supported_extensions>GB</supported_extensions>
<supported_extensions>GBC</supported_extensions>
</core>

<core>
<emucore name="Genesis/MD (PicoDrive)" file="picodrive_libretro.so" />
<supported_extensions>BIN</supported_extensions>
<supported_extensions>GEN</supported_extensions>
<supported_extensions>SMD</supported_extensions>
<supported_extensions>MD</supported_extensions>
</core>

<core>
<emucore name="NES (FCEUmm)" file="fceumm_libretro.so" />
<supported_extensions>NES</supported_extensions>
<supported_extensions>FDS</supported_extensions>
<supported_extensions>UNIF</supported_extensions>
<supported_extensions>UNF</supported_extensions>
</core>

<core>
<emucore name="NES (Nestopia)" file="nestopia_libretro.so" />
<supported_extensions>NES</supported_extensions>
</core>
